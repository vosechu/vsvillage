// Makes vanilla chiseled blocks count as room walls for heat retention.
// Skipped entirely when Rythillian's ChiseledBlockRetention (modid "cbr") is installed,
// which does the same job. Otherwise disable via villageconfig.json
// ChiseledBlocksCountAsWalls=false (handled in ChiseledBlockLeniencySystem.cs).
[
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "remove",
        "path": "/sidesolid/all",
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/down",
        "value": true,
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/east",
        "value": true,
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/north",
        "value": true,
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/south",
        "value": true,
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/up",
        "value": false,
        "side": "server"
    },
    {
        "dependsOn": [{ "modid": "cbr", "invert": true }],
        "file": "game:blocktypes/chiseled/chiseledblock.json",
        "op": "add",
        "path": "/sidesolid/west",
        "value": true,
        "side": "server"
    }
]
